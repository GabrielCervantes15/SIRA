# ============================================================================
# SIRA CRM - ITSON: Variables de Entorno y Configuración
# ============================================================================
# Copie este archivo a '.env' y ajuste los valores correspondientes a su entorno local.
# ADVERTENCIA: NUNCA guarde contraseñas ni secretos reales en este archivo de ejemplo.

# ----------------------------------------------------------------------------
# 1. Configuración General del Servidor Backend
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=sira-crm-backend
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL (Monolito Modular por Esquemas)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sira_db
DB_USER=sira_admin
DB_PASSWORD=sira_secret_password_dev
DB_SCHEMAS=usuarios,aspirantes,alertas,conocimiento
DB_POOL_MIN=2
DB_POOL_MAX=10

# ----------------------------------------------------------------------------
# 3. Bus de Eventos (RabbitMQ)
# ----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=sira_rabbit
RABBITMQ_PASSWORD=sira_rabbit_secret_dev
RABBITMQ_VHOST=/
RABBITMQ_MGMT_PORT=15672
RABBITMQ_EXCHANGE=crm.eventos
RABBITMQ_QUEUE_DEAD_LETTER=crm.dlq

# ----------------------------------------------------------------------------
# 4. Seguridad, Tokens y Autenticación (Sprint 1: Simulado / Active Directory)
# ----------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_para_desarrollo_local_min_32_chars
JWT_EXPIRES_IN=8h
SESSION_SECRET=session_secret_cookie_key_local_only
AUTH_MOCK_ENABLED=true
ITSON_AD_KERBEROS_REALM=ITSON.MX
ITSON_AD_SERVER_URL=ldap://ad.itson.mx

# ----------------------------------------------------------------------------
# 5. Integración: Registro Escolar (Sprint 1: Adaptador Simulado)
# ----------------------------------------------------------------------------
REGISTRO_ESCOLAR_MOCK_ENABLED=true
REGISTRO_ESCOLAR_API_URL=https://api-registroescolar.itson.mx/v1
REGISTRO_ESCOLAR_API_KEY=dummy_mock_key_sprint1

# ----------------------------------------------------------------------------
# 6. Integración: WhatsApp Cloud API (Sprint 1: Simulado)
# ----------------------------------------------------------------------------
WHATSAPP_MOCK_ENABLED=true
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=mock_phone_id
WHATSAPP_ACCESS_TOKEN=mock_bearer_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mock_webhook_verification_token

# ----------------------------------------------------------------------------
# 7. Integración: Servicio de IA Generativa (Sprint 1: Simulado)
# ----------------------------------------------------------------------------
IA_MOCK_ENABLED=true
IA_SERVICE_API_URL=https://api.generativeai.example.com/v1
IA_SERVICE_API_KEY=mock_ia_api_key
IA_MODEL_NAME=gemini-1.5-flash

# ----------------------------------------------------------------------------
# 8. Notificaciones por Correo (SMTP de Pruebas - Mailpit/MailHog)
# ----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SIRA Admisiones ITSON <admisiones@itson.edu.mx>"
